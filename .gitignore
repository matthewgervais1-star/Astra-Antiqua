# Monorepo root — OS / editor junk and stray dumps.
# Per-surface ignores live in web/.gitignore and android/.gitignore.
.DS_Store
Thumbs.db
*.hprof

# Machine-local Claude permissions (not shared)
.claude/settings.local.json

# Next/tsc artifacts that land at the root when tooling runs from the
# wrong directory — the real ones live under web/.
/next-env.d.ts
/tsconfig.tsbuildinfo
/.next/

# Design handoff deliveries arrive as zips at the repo root. Their contents
# are extracted and committed under docs/design/handoff/, so the archive
# itself is redundant history.
/*.zip

# A nested clone left behind by a worktree recycle. Not part of this repo.
/astra-antiqua/
# Claude Code transcripts stay local
_sessions/
