# Copy to keystore.properties (gitignored) and fill in to sign release builds.
# Without this file the release build falls back to debug signing, so a fresh
# clone still builds; it just cannot produce an uploadable artifact.
#
# Generate the keystore yourself, from the android/ directory:
#
#   keytool -genkeypair -v -keystore astra-antiqua-release.jks \
#     -alias astra-antiqua -keyalg RSA -keysize 4096 -validity 10000
#
# Keep the .jks and this file out of version control (both are gitignored)
# and back the keystore up somewhere durable: losing it means you can never
# ship an update to an app already published under it.

storeFile=astra-antiqua-release.jks
storePassword=
keyAlias=astra-antiqua
keyPassword=
