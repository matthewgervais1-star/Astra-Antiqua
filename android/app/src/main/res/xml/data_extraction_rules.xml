<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup and device transfer on Android 12 and above. Same rule as
  backup_rules.xml: everything travels except the web session.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/account_session.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/account_session.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
