{
  "name": "astra-antiqua-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--use-system-ca next dev",
    "build": "next build",
    "start": "cross-env NODE_OPTIONS=--use-system-ca next start",
    "start:lan": "cross-env NODE_OPTIONS=--use-system-ca ASTRA_ALLOW_HTTP=1 next start -H 0.0.0.0",
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "gates": "node scripts/check-gates.mjs",
    "test": "node --import ./scripts/register-alias.mjs --test \"src/**/*.test.ts\"",
    "specimens": "node scripts/specimens/gen-specimens.mjs && node scripts/specimens/render.mjs && node scripts/specimens/build-css.mjs && node scripts/specimens/wrap-cards.mjs",
    "export:content": "node scripts/export-content.mjs",
    "export:goldens": "node scripts/export-goldens.mjs",
    "export:glyphs": "node scripts/export-glyphs.mjs",
    "export:marks": "node scripts/export-marks.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "astronomy-engine": "^2.1.19",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "jose": "^6.2.3",
    "motion": "^11.18.2",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.54.2",
    "tz-lookup": "^6.1.25",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "postcss": "^8.4.49",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5"
  }
}
