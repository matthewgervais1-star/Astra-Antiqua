<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AstraAntiqua.Core\AstraAntiqua.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generated by web/scripts/export-goldens.mjs — do not hand-edit. -->
    <None Include="TestData\goldens.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generated by web/scripts/export-strings.mjs; never hand-edit. Embedded
         as test data so the tests read the same bytes web wrote. -->
    <EmbeddedResource Include="..\..\shared\goldens\formats.json" LogicalName="Goldens.formats.json" />
    <EmbeddedResource Include="..\..\shared\strings\manifest.json" LogicalName="Strings.manifest.json" />
  </ItemGroup>

</Project>
