<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0 keeps the library consumable by any head (MAUI 10,
         or anything later); net8.0 is what this workstation builds and
         tests against. -->
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AstraAntiqua.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same upstream ephemeris as web's npm package and Android's JAR. -->
    <PackageReference Include="CosineKitty.AstronomyEngine" Version="2.1.19" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- shared/content/*.json is generated by web/scripts/export-content.mjs
         and embedded here so the library is self-contained for any head. -->
    <EmbeddedResource Include="..\..\shared\content\*.json" Exclude="..\..\shared\content\manifest.json" LinkBase="Content" />
  </ItemGroup>

</Project>
